{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cfexp.local/schemas/experiment-v1.schema.json",
  "title": "cfexp Experiment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {
      "const": "cfexp/v1"
    },
    "kind": {
      "const": "Experiment"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "variableName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^(?!~)(?!/)(?!\\\\\\\\)(?![A-Za-z]:[\\\\/]).+"
        },
        {
          "pattern": "^(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$)).+"
        }
      ]
    },
    "noEnvironmentReference": {
      "not": {
        "pattern": "\\$(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[A-Za-z_][A-Za-z0-9_]*)"
      }
    },
    "noSecretLiteral": {
      "not": {
        "pattern": "(?:hf_[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})"
      }
    },
    "unmanagedVariableName": {
      "allOf": [
        {
          "$ref": "#/$defs/variableName"
        },
        {
          "not": {
            "enum": [
              "CFEXP_ATTEMPT_ID",
              "CFEXP_CACHE_DIR",
              "CFEXP_MODEL_ROOT",
              "CFEXP_RUN_DIR",
              "CFEXP_UV_BIN",
              "CUDA_VISIBLE_DEVICES",
              "HF_ENDPOINT",
              "HF_HOME",
              "HF_HUB_CACHE",
              "HF_TOKEN",
              "HF_XET_CACHE",
              "MODEL_ROOT",
              "PYTHONHASHSEED",
              "PYTHONNOUSERSITE",
              "PYTHONDONTWRITEBYTECODE",
              "TMPDIR",
              "TORCH_HOME",
              "UV_CACHE_DIR",
              "UV_PROJECT_ENVIRONMENT"
            ]
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "runtime",
        "command",
        "resources",
        "outputs",
        "storage",
        "policy"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "parameters": true,
        "outputs": {
          "$ref": "#/$defs/outputs"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resources": {
                "required": ["gpus", "expected_duration_minutes"],
                "properties": {
                  "gpus": {
                    "minimum": 4
                  },
                  "expected_duration_minutes": {
                    "exclusiveMinimum": 120
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "policy": {
                "required": ["coordination_notice_ref"]
              }
            }
          }
        }
      ]
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "require_clean"],
      "properties": {
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "require_clean": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": {
          "enum": ["uv", "image"]
        },
        "python": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "lockfile": {
          "const": "uv.lock"
        },
        "image": {
          "type": "string",
          "pattern": "^\\S+@[sS][hH][aA]256:[0-9a-fA-F]{64}$"
        },
        "engine": {
          "const": "docker"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "uv"
              }
            }
          },
          "then": {
            "required": ["lockfile"]
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": ["image"]
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/nonEmptyString"
              },
              {
                "$ref": "#/$defs/noEnvironmentReference"
              },
              {
                "$ref": "#/$defs/noSecretLiteral"
              }
            ]
          }
        },
        "cwd": {
          "$ref": "#/$defs/relativePath"
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/unmanagedVariableName"
          },
          "additionalProperties": {
            "type": "string",
            "allOf": [
              {
                "$ref": "#/$defs/noEnvironmentReference"
              },
              {
                "$ref": "#/$defs/noSecretLiteral"
              }
            ]
          }
        },
        "secret_env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/unmanagedVariableName"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpus", "expected_duration_minutes"],
      "properties": {
        "gpus": {
          "type": "integer",
          "minimum": 0
        },
        "min_gpu_memory_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memory_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expected_duration_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uri", "target"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "uri": {
          "allOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "$ref": "#/$defs/noEnvironmentReference"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      },
      "oneOf": [
        {
          "required": ["sha256"],
          "not": {
            "required": ["revision"]
          }
        },
        {
          "required": ["revision"],
          "not": {
            "required": ["sha256"]
          },
          "properties": {
            "uri": {
              "pattern": "^(?:hf://|https://huggingface\\.co/)"
            }
          }
        }
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "glob": {
          "$ref": "#/$defs/relativePath"
        },
        "publish_interval_sec": {
          "type": "integer",
          "minimum": 1
        },
        "stable_for_sec": {
          "type": "integer",
          "minimum": 0
        },
        "resume_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "remote"],
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "remote": {
          "type": "string",
          "oneOf": [
            {
              "const": "${CFEXP_ARTIFACT_REMOTE}"
            },
            {
              "allOf": [
                {
                  "pattern": "^file:///(?!/*$).+"
                },
                {
                  "$ref": "#/$defs/noEnvironmentReference"
                }
              ]
            },
            {
              "allOf": [
                {
                  "pattern": "^[A-Za-z0-9._-]+:(?!//).*"
                },
                {
                  "$ref": "#/$defs/noEnvironmentReference"
                }
              ]
            }
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordination_notice_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
